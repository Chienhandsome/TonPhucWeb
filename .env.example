# Sao chép file này thành .env.local và điền giá trị thật.
# KHÔNG commit .env.local, KHÔNG ghi secret vào code hay README.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Tên bucket ảnh bìa trong Supabase Storage (tạo trong SQL, xem supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=images
