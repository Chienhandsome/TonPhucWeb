diff --git a/supabase/schema.sql b/supabase/schema.sql
new file mode 100644
index 0000000..b180ca8
--- /dev/null
+++ b/supabase/schema.sql
@@ -0,0 +1,76 @@
+-- Schema Supabase cho website Gas Lạnh Tôn Phúc.
+-- Chạy file này trong Supabase Dashboard → SQL Editor, trên project mới.
+-- Không chứa secret. Tài khoản admin tạo riêng trong Authentication, không tạo trong SQL này.
+
+create extension if not exists pgcrypto;
+
+create table if not exists public.categories (
+  id uuid primary key default gen_random_uuid(),
+  name text not null,
+  slug text not null unique,
+  created_at timestamptz not null default now()
+);
+
+create table if not exists public.posts (
+  id uuid primary key default gen_random_uuid(),
+  title text not null,
+  slug text not null unique,
+  excerpt text,
+  content text,
+  cover_image text,
+  category_id uuid references public.categories(id) on delete set null,
+  published boolean not null default true,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+-- Tự cập nhật updated_at khi sửa bài.
+create or replace function public.set_updated_at()
+returns trigger language plpgsql as $$
+begin
+  new.updated_at = now();
+  return new;
+end;
+$$;
+
+drop trigger if exists posts_set_updated_at on public.posts;
+create trigger posts_set_updated_at
+  before update on public.posts
+  for each row execute function public.set_updated_at();
+
+-- Bucket ảnh bìa. Nếu bucket đã tồn tại thì bỏ qua bước insert này.
+insert into storage.buckets (id, name, public)
+values ('images', 'images', true)
+on conflict (id) do nothing;
+
+-- Row Level Security: skeleton dùng mô hình admin dùng chung.
+-- Khách chỉ đọc được bài đã xuất bản và danh mục.
+-- Người đã đăng nhập (tài khoản admin trong Supabase Auth) mới được ghi.
+alter table public.categories enable row level security;
+alter table public.posts enable row level security;
+
+drop policy if exists "public read categories" on public.categories;
+create policy "public read categories" on public.categories
+  for select using (true);
+
+drop policy if exists "public read published posts" on public.posts;
+create policy "public read published posts" on public.posts
+  for select using (published = true);
+
+drop policy if exists "authenticated write categories" on public.categories;
+create policy "authenticated write categories" on public.categories
+  for all using (auth.role() = 'authenticated') with check (auth.role() = 'authenticated');
+
+drop policy if exists "authenticated write posts" on public.posts;
+create policy "authenticated write posts" on public.posts
+  for all using (auth.role() = 'authenticated') with check (auth.role() = 'authenticated');
+
+-- Storage: ảnh bìa đọc công khai; chỉ tài khoản đăng nhập mới upload/xóa.
+drop policy if exists "public read images" on storage.objects;
+create policy "public read images" on storage.objects
+  for select using (bucket_id = 'images');
+
+drop policy if exists "authenticated write images" on storage.objects;
+create policy "authenticated write images" on storage.objects
+  for all using (bucket_id = 'images' and auth.role() = 'authenticated')
+  with check (bucket_id = 'images' and auth.role() = 'authenticated');
diff --git a/supabase/seed.sql b/supabase/seed.sql
new file mode 100644
index 0000000..0f9cba4
--- /dev/null
+++ b/supabase/seed.sql
@@ -0,0 +1,32 @@
+-- Seed mẫu: CHỈ tiêu đề + mô tả tạm placeholder, lấy từ trang chủ tonphuc.com ngày 01/11/2026.
+-- Không bịa nội dung chi tiết, không bịa giá. Chạy sau schema.sql.
+-- Khi chuyển nội dung thật từ tài khoản admin, cập nhật lại excerpt/content của từng bài.
+
+insert into public.categories (name, slug) values
+  ('Giới thiệu', 'gioi-thieu'),
+  ('Sản phẩm', 'san-pham'),
+  ('Báo giá', 'bao-gia'),
+  ('Kiến thức', 'kien-thuc')
+on conflict (slug) do nothing;
+
+insert into public.posts (title, slug, excerpt, content, category_id, published)
+select
+  v.title, v.slug,
+  'Nội dung đang được chuyển từ web cũ — sẽ thay bằng bài đầy đủ lấy từ tài khoản admin.',
+  'Nội dung đang được chuyển từ web cũ — sẽ thay bằng bài đầy đủ lấy từ tài khoản admin.',
+  c.id, true
+from (values
+  ('Đại Lý Phân Phối Gas Lạnh Hàng Đầu TP.HCM', 'dai-ly-phan-phoi-gas-lanh-hang-dau-tphcm', 'gioi-thieu'),
+  ('Báo Giá Gas Lạnh R22, R32, R410A Chính Hãng', 'bao-gia-gas-lanh-r22-r32-r410a-chinh-hang', 'bao-gia'),
+  ('Gas R22 có độc không', 'gas-r22-co-doc-khong', 'kien-thuc'),
+  ('Gas R32 có độc không', 'gas-r32-co-doc-khong', 'kien-thuc'),
+  ('Cung Cấp Gas Lạnh R507 & R407C Cho Kho Lạnh, Máy Chiller Tại TP.HCM', 'cung-cap-gas-lanh-r507-r407c-cho-kho-lanh-may-chiller-tphcm', 'san-pham'),
+  ('Gas R410A có cháy không', 'gas-r410a-co-chay-khong', 'kien-thuc'),
+  ('Cung Cấp Vật Tư Điện Lạnh Giá Sỉ Tại TP.HCM', 'cung-cap-vat-tu-dien-lanh-gia-si-tphcm', 'san-pham'),
+  ('Thay gas R410A bằng R32 được không', 'thay-gas-r410a-bang-r32-duoc-khong', 'kien-thuc'),
+  ('Gas R410A có nạp bổ sung được không', 'gas-r410a-co-nap-bo-sung-duoc-khong', 'kien-thuc'),
+  ('Gas Lạnh R22 Ấn Độ', 'gas-lanh-r22-an-do', 'san-pham'),
+  ('Nhà Cung Cấp Gas Lạnh Chemours', 'nha-cung-cap-gas-lanh-chemours', 'san-pham')
+) as v(title, slug, cat_slug)
+join public.categories c on c.slug = v.cat_slug
+on conflict (slug) do nothing;
